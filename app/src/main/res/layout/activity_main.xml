<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:descendantFocusability="beforeDescendants"
        android:focusableInTouchMode="true"
        android:padding="20dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#E3F2FD"
            android:textSize="18sp"
            android:text="Status: –" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Speichern &amp; Starten" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stoppen" />
        </LinearLayout>

        <TextView
            style="@android:style/TextAppearance.Material.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Lampen" />

        <LinearLayout
            android:id="@+id/lampsBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F3E5F5"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Musikmodus (Mikrofon des Tablets)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Diese Lampen machen mit:" />

            <LinearLayout
                android:id="@+id/musicLamps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Musikquelle (welches Tablet hört zu):" />

            <Spinner
                android:id="@+id/musicSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnMusic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Musikmodus starten" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Empfindlichkeit" />

            <SeekBar
                android:id="@+id/musicSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="150" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tempo der Farbwechsel-Effekte" />

            <SeekBar
                android:id="@+id/sequenceSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FBE9E7"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Lagerfeuer-Effekt" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tempo (langsam ↔ schnell)" />

            <SeekBar
                android:id="@+id/fireSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stärke (sanftes Glimmen ↔ wildes Lodern)" />

            <SeekBar
                android:id="@+id/fireStrength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Helligkeit" />

            <SeekBar
                android:id="@+id/fireBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/debugLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Debug-Log (alle Mesh-Pakete protokollieren)" />

        <LinearLayout
            android:id="@+id/updateBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFF8E1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/updateStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Version –" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nach Update suchen" />

                <Button
                    android:id="@+id/btnInstallUpdate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Update installieren" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@android:style/TextAppearance.Material.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="1. AwoX / EGLO Connect Konto" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nur zum einmaligen Import der Mesh-Zugangsdaten und Lampenliste." />

        <EditText
            android:id="@+id/awoxUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="E-Mail"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/awoxPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Passwort"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btnImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lampen aus AwoX-Cloud importieren" />

        <TextView
            android:id="@+id/devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="#F5F5F5"
            android:text="Keine Lampen importiert" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            android:text="Für welche Lampen ist dieses Tablet zuständig?" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nur mit diesen Lampen verbindet sich das Tablet und nur diese steuert es. Die übrigen übernimmt eine andere Bridge (z.B. der Pi in der Küche). Auch in Home Assistant unter der Bridge änderbar." />

        <LinearLayout
            android:id="@+id/assignLamps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@android:style/TextAppearance.Material.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="2. MQTT (Home Assistant Mosquitto)" />

        <EditText
            android:id="@+id/bridgeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Name dieses Tablets (z. B. Tablet Wohnzimmer)"
            android:inputType="text" />

        <EditText
            android:id="@+id/mqttHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Host / IP"
            android:inputType="text" />

        <EditText
            android:id="@+id/mqttPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Port (1883)"
            android:inputType="number" />

        <EditText
            android:id="@+id/mqttUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MQTT-Benutzer"
            android:inputType="text" />

        <EditText
            android:id="@+id/mqttPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MQTT-Passwort"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            android:text="Einrichtung durch Assistent (z. B. Claude)" />

        <RadioGroup
            android:id="@+id/assistantAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/accessHa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zentral über Home Assistant" />

            <RadioButton
                android:id="@+id/accessMcp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dezentral: MCP-Zugang auf dieser Bridge (Port 8765)" />

            <RadioButton
                android:id="@+id/accessBoth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beides" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="Zentral: Einstellungen kommen über MQTT (Home Assistant, Entität „Name“ usw.). Dezentral: Assistenten verbinden sich direkt mit http://&lt;IP&gt;:8765/mcp – ohne Passwort, also nur in einem vertrauenswürdigen WLAN. Lampen schalten geht immer." />

        <TextView
            style="@android:style/TextAppearance.Material.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Kiosk-Modus (Dashboard im Vollbild)" />

        <EditText
            android:id="@+id/kioskUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dashboard-Adresse, z. B. http://192.168.178.120:8123/grundriss-2d"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/kioskPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PIN zum Verlassen (5× oben links tippen)"
            android:inputType="numberPassword" />

        <CheckBox
            android:id="@+id/kioskEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kiosk-Modus beim Start" />

        <CheckBox
            android:id="@+id/voiceEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sprach-Satellit für Home Assistant (ESPHome, Port 6053)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnKiosk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kiosk starten" />

            <Button
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Als Startbildschirm festlegen" />
        </LinearLayout>

        <TextView
            style="@android:style/TextAppearance.Material.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="3. Berechtigungen" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPerms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Standort erlauben" />

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Akku-Optimierung aus" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Für den Kiosk-Betrieb (alles über Home Assistant) einmalig erlauben:" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mikrofon" />

            <Button
                android:id="@+id/btnOverlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Über Apps einblenden" />

            <Button
                android:id="@+id/btnInstallPerm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Apps installieren" />
        </LinearLayout>

        <Button
            android:id="@+id/btnWriteSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Systemeinstellungen ändern (Bildschirm wirklich aus)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <TextView
                style="@android:style/TextAppearance.Material.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Log" />

            <Button
                android:id="@+id/btnCopyLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log kopieren" />
        </LinearLayout>

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#212121"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="#E0E0E0"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
